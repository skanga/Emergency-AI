  "infant_extraction": {
    "exact_saved_passage_reproduced": true,
    "blocks": [
      {
        "path": [
          [
            2,
            "Treatment"
          ],
          [
            3,
            "Particular cases"
          ],
          [
            4,
            "Infants (babies under 1 year-old)"
          ]
        ],
        "is_warning": true,
        "text": "In the chest thrusts manoeuver, the baby's body is placed lying face up on a surface (it can be the rescuer's thighs, lap or forearm). Then, the rescuer does the compressions pressing with only two fingers on the lower half of the bone that is along the middle of the chest from the neck to the belly (on the chest bone, named sternum, on its part that is the nearest to the belly). Abdominal thrusts are not recommended in children less than one year old because they can cause liver damage.[59]"
      },
      {
        "path": [
          [
            2,
            "Treatment"
          ],
          [
            3,
            "Particular cases"
          ],
          [
            4,
            "Infants (babies under 1 year-old)"
          ],
          [
            5,
            "Unconscious infants"
          ]
        ],
        "is_warning": false,
        "text": "Until emergency services arrive, the American Heart Association[59] recommends starting cardiopulmonary resuscitation (CPR) adapted to infants (<1 year old). It is a cycle of resuscitation[60] that alternates compressions and rescue breaths, like in a normal CPR, but with some differences:\nThe rescuer begins by making 30 compressions, pressing, with two thumbs or the heel of one's hand, on the lower half of the bone in the middle of the chest (the sternum, on its part that is the nearest to the belly), at an approximate rate of nearly 2 per second (100-120 compressions per minute)."
      }
    ]
  },
